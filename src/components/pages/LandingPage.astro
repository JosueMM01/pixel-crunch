---
import { getLocalizedRoute, type Locale } from '../../i18n/routes';
import { siteContent } from '../../i18n/site';
import LandingDocumentation from './LandingDocumentation.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = siteContent[lang].landing;
const tools = content.tools as ReadonlyArray<{
  route: 'compress' | 'convert' | 'removeBackground';
  title: string;
  description: string;
  action: string;
  status?: string;
  accent: 'cyan' | 'pink' | 'green';
}>;
const accentClasses = {
  cyan: 'border-monokai-cyan/35 text-monokai-cyan',
  pink: 'border-monokai-pink/35 text-monokai-pink',
  green: 'border-monokai-green/35 text-monokai-green',
};
---

<div class="bg-monokai-bg text-monokai-fg">
<section class="px-4 pb-12 pt-10 md:pb-16 md:pt-16">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-4xl">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.2em] text-monokai-cyan">Pixel Crunch 2.0</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight text-monokai-fg md:text-6xl">{content.heading}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-monokai-fg/80 md:text-xl">{content.intro}</p>
      <p class="mt-4 max-w-3xl border-l-2 border-monokai-green pl-4 text-sm leading-relaxed text-monokai-fg/70">{content.privacyNote}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#tools" class="inline-flex min-h-11 items-center rounded-lg bg-monokai-cyan px-5 py-2.5 font-semibold text-monokai-bg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-monokai-cyan">
          {content.exploreToolsLabel}
        </a>
        <a href="#overview" class="inline-flex min-h-11 items-center rounded-lg border border-monokai-fg/25 px-5 py-2.5 font-semibold text-monokai-fg transition-colors hover:border-monokai-cyan/60 hover:text-monokai-cyan focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-monokai-cyan">
          {content.learnMoreLabel}
        </a>
      </div>
    </div>

    <h2 id="tools" class="mt-14 text-2xl font-bold text-monokai-fg md:text-3xl">{content.toolsHeading}</h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {tools.map((tool, index) => (
        <article class:list={['flex min-h-72 flex-col rounded-2xl border bg-monokai-bg/55 p-6 shadow-sm', accentClasses[tool.accent]]}>
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-sm opacity-70">0{index + 1}</span>
            {tool.status ? <span class="rounded-full border border-current px-2.5 py-1 text-xs font-semibold">{tool.status}</span> : null}
          </div>
          <h3 class="mt-8 text-2xl font-bold">{tool.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-monokai-fg/75">{tool.description}</p>
          <a
            href={getLocalizedRoute(lang, tool.route)}
            class="mt-7 inline-flex min-h-11 items-center justify-between rounded-xl border border-current px-4 py-2.5 font-semibold transition-colors hover:bg-current/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
          >
            <span>{tool.action}</span><span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {content.benefits.map((benefit) => (
        <div class="rounded-xl border border-monokai-fg/15 bg-monokai-bg/35 p-5">
          <h3 class="font-bold text-monokai-fg">{benefit.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-monokai-fg/70">{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<LandingDocumentation lang={lang} />
</div>
