---
interface Props {
  label: string;
  description: string;
}

const { label, description } = Astro.props;
---

<div class="flex min-h-64 flex-col items-center justify-center rounded-xl border border-dashed border-monokai-green/45 bg-monokai-green/5 px-6 py-12 text-center">
  <span class="rounded-full border border-monokai-green/50 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-monokai-green">
    {label}
  </span>
  <p class="mt-5 max-w-2xl text-sm leading-relaxed text-monokai-fg/75 md:text-base">{description}</p>
</div>
