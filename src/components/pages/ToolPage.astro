---
interface Props {
  heading: string;
  accent?: 'cyan' | 'pink' | 'green';
}

const { heading, accent = 'cyan' } = Astro.props;
const accentClasses = {
  cyan: 'text-monokai-cyan border-monokai-cyan/35',
  pink: 'text-monokai-pink border-monokai-pink/35',
  green: 'text-monokai-green border-monokai-green/35',
};
---

<section class="px-4 pb-4 pt-6 md:pb-5 md:pt-8">
  <div class="mx-auto max-w-5xl">
    <h1 class:list={['text-2xl font-bold leading-tight md:text-3xl', accentClasses[accent].split(' ')[0]]}>{heading}</h1>
  </div>
</section>

<section class="px-3 pb-16 sm:px-4 md:pb-20" aria-label={heading}>
  <div class="mx-auto max-w-5xl">
    <slot />
  </div>
</section>
