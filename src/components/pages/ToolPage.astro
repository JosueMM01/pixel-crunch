---
import { getLocalizedRoute, type Locale, type RouteKey } from '../../i18n/routes';

interface Props {
  heading: string;
  intro: string;
  bullets: readonly string[];
  formats?: readonly string[];
  detailsTitle: string;
  details: string;
  faq: ReadonlyArray<{ question: string; answer: string }>;
  lang: Locale;
  route: Exclude<RouteKey, 'home'>;
  accent?: 'cyan' | 'pink' | 'green';
}

const { heading, intro, bullets, formats, detailsTitle, details, faq, lang, route, accent = 'cyan' } = Astro.props;
const accentClasses = {
  cyan: 'text-monokai-cyan border-monokai-cyan/35',
  pink: 'text-monokai-pink border-monokai-pink/35',
  green: 'text-monokai-green border-monokai-green/35',
};
const labels = lang === 'en'
  ? { home: 'Home', features: 'What you can do', formats: 'Supported formats', faq: 'Frequently asked questions', related: 'More image tools' }
  : { home: 'Inicio', features: 'Qué puedes hacer', formats: 'Formatos compatibles', faq: 'Preguntas frecuentes', related: 'Más herramientas de imágenes' };
const relatedRoutes = (['compress', 'convert', 'removeBackground'] as const).filter((key) => key !== route);
const routeLabels = lang === 'en'
  ? { compress: 'Compress images', convert: 'Convert images', removeBackground: 'Remove image backgrounds' }
  : { compress: 'Comprimir imágenes', convert: 'Convertir imágenes', removeBackground: 'Quitar fondo de imágenes' };
---

<section class="px-4 pb-4 pt-6 md:pb-5 md:pt-8">
  <div class="mx-auto max-w-5xl">
    <nav aria-label={lang === 'en' ? 'Breadcrumb' : 'Migas de pan'} class="mb-3 text-sm text-monokai-fg/60">
      <a href={getLocalizedRoute(lang, 'home')} class="hover:text-monokai-cyan">{labels.home}</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span aria-current="page">{heading}</span>
    </nav>
    <h1 class:list={['text-2xl font-bold leading-tight md:text-3xl', accentClasses[accent].split(' ')[0]]}>{heading}</h1>
  </div>
</section>

<section class="px-3 pb-16 sm:px-4 md:pb-20" aria-label={heading}>
  <div class="mx-auto max-w-5xl">
    <slot />
  </div>
</section>

<section class="border-t border-monokai-fg/10 px-4 py-12 md:py-16" aria-labelledby="tool-details-title">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]">
      <div>
        <h2 id="tool-details-title" class="text-2xl font-bold text-monokai-fg">{detailsTitle}</h2>
        <p class="mt-4 leading-relaxed text-monokai-fg/75">{intro}</p>
        <p class="mt-3 leading-relaxed text-monokai-fg/65">{details}</p>
      </div>
      <div>
        <h3 class="font-semibold text-monokai-fg">{labels.features}</h3>
        <ul class="mt-3 space-y-2 text-sm text-monokai-fg/70">
          {bullets.map((item) => <li class="flex gap-2"><span class="text-monokai-green" aria-hidden="true">✓</span><span>{item}</span></li>)}
        </ul>
        {formats?.length ? (
          <>
            <h3 class="mt-6 font-semibold text-monokai-fg">{labels.formats}</h3>
            <p class="mt-3 flex flex-wrap gap-2">
              {formats.map((format) => <span class="rounded-full border border-monokai-fg/15 px-3 py-1 text-xs text-monokai-fg/70">{format}</span>)}
            </p>
          </>
        ) : null}
      </div>
    </div>

    <div class="mt-10 grid gap-3 md:grid-cols-3">
      <h2 class="text-xl font-bold text-monokai-fg md:col-span-3">{labels.faq}</h2>
      {faq.map((item) => (
        <details class="group rounded-xl border border-monokai-fg/15 bg-monokai-bg/40 p-4 open:border-monokai-cyan/35">
          <summary class="cursor-pointer list-none font-semibold text-monokai-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-monokai-cyan">{item.question}</summary>
          <p class="mt-3 text-sm leading-relaxed text-monokai-fg/70">{item.answer}</p>
        </details>
      ))}
    </div>

    <nav aria-label={labels.related} class="mt-10 border-t border-monokai-fg/10 pt-6">
      <h2 class="text-lg font-bold text-monokai-fg">{labels.related}</h2>
      <div class="mt-3 flex flex-wrap gap-3">
        {relatedRoutes.map((key) => (
          <a href={getLocalizedRoute(lang, key)} class="rounded-lg border border-monokai-fg/20 px-4 py-2 text-sm font-semibold text-monokai-cyan hover:border-monokai-cyan/50">{routeLabels[key]} →</a>
        ))}
      </div>
    </nav>
  </div>
</section>
