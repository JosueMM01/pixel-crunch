---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { Toaster } from '../components/ui/Toaster';
import { getLocalizedRoute, type RouteKey } from '../i18n/routes';
import { buildStructuredData, type FaqItem } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	lang?: 'es' | 'en';
	canonical?: string;
	ogImage?: string;
	route?: RouteKey;
	noindex?: boolean;
	featureList?: string[];
	pageName?: string;
	faqItems?: readonly FaqItem[];
}

const {
	title = 'Pixel Crunch - Optimiza Imágenes en tu Navegador',
	description = 'Herramienta gratuita y privada para comprimir imágenes (JPG, PNG, WebP) sin subir archivos a un servidor. Todo el procesamiento ocurre en tu navegador.',
	lang = 'es',
	canonical,
	ogImage = '/Logo.png',
	route = 'home',
	noindex = false,
	featureList,
	pageName = 'Pixel Crunch',
	faqItems,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
const ogImageType = ogImageUrl.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
const isEnglish = lang.startsWith('en');
const ogLocale = isEnglish ? 'en_US' : 'es_ES';
const ogImageAlt = isEnglish ? 'Pixel Crunch logo' : 'Logo de Pixel Crunch';
const hreflangEs = new URL(getLocalizedRoute('es', route), siteUrl).toString();
const hreflangEn = new URL(getLocalizedRoute('en', route), siteUrl).toString();
const robotsContent = noindex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const structuredData = buildStructuredData({
	siteUrl,
	canonicalUrl,
	imageUrl: ogImageUrl,
	imageAlt: ogImageAlt,
	lang,
	route,
	title,
	description,
	pageName,
	faqItems,
	featureList: featureList ?? [
		'JPG/JPEG/JFIF compression',
		'PNG compression',
		'WebP compression',
		'GIF compression',
		'SVG optimization',
		'Browser-compatible image format conversion',
		'Client-side processing (no server upload)',
		'Quality control slider',
		'Before/after comparison',
		'Batch compression',
		'ZIP download',
	],
});
const structuredDataJson = JSON.stringify(structuredData);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		
		<!-- SEO Meta Tags -->
		<meta name="author" content="Pixel Crunch" />
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={robotsContent} />
		<meta name="application-name" content="Pixel Crunch" />
		<meta name="apple-mobile-web-app-title" content="Pixel Crunch" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="format-detection" content="telephone=no" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" href={hreflangEs} hreflang="es" />
		<link rel="alternate" href={hreflangEn} hreflang="en" />
		<link rel="alternate" href={hreflangEs} hreflang="x-default" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Pixel Crunch" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={isEnglish ? 'es_ES' : 'en_US'} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content="160" />
		<meta property="og:image:height" content="133" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" />
		
		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<script src="/registerSW.js" defer is:inline></script>
		
		<!-- Theme Color -->
		<meta name="theme-color" content="#272822" />
		<meta name="color-scheme" content="light dark" />
		
		<!-- Generator -->
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>

		<script type="application/ld+json" set:html={structuredDataJson} />
		
		<script is:inline>
			(() => {
				const storageKey = 'theme';
				const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
				const savedTheme = localStorage.getItem(storageKey);
				const theme =
					savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'system'
						? savedTheme
						: 'system';

				const shouldUseDark = theme === 'dark' || (theme === 'system' && mediaQuery.matches);
				document.documentElement.classList.toggle('dark', shouldUseDark);
			})();
		</script>
	</head>
	<body class="antialiased font-sans flex flex-col min-h-screen bg-white dark:bg-monokai-bg text-gray-900 dark:text-monokai-fg transition-colors duration-300">
		<a
			href="#main-content"
			class="sr-only z-50 rounded-md bg-white px-4 py-2 text-gray-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:outline-2 focus:outline-offset-2 focus:outline-brand-blue"
		>
			{isEnglish ? 'Skip to main content' : 'Saltar al contenido principal'}
		</a>
		<Header lang={lang} route={route} />
		<main id="main-content" class="flex-1 pb-8" tabindex="-1">
			<slot />
		</main>
		<Toaster client:load />
		<Footer lang={lang} />
	</body>
</html>
