---
import Layout from '../layouts/Layout.astro';

// Detect language from the requested path
const pathname = Astro.url.pathname;
const isEnglish = pathname === '/en' || pathname.startsWith('/en/');
const lang = isEnglish ? 'en' : 'es';

const title = isEnglish
  ? 'Page not found — Pixel Crunch'
  : 'Página no encontrada — Pixel Crunch';

const description = isEnglish
  ? 'The page you are looking for does not exist.'
  : 'La página que buscas no existe.';

const heading = isEnglish ? 'Page not found' : 'Página no encontrada';
const buttonLabel = isEnglish ? 'Go to home' : 'Ir al inicio';
const buttonHref = isEnglish ? '/en/' : '/';
---

<Layout title={title} description={description} lang={lang}>
	<main class="min-h-[70vh] flex items-center justify-center px-4 pt-16 md:pt-24">
		<div class="text-center max-w-lg">
			<!-- 404 number -->
			<p class="text-[10rem] md:text-[14rem] font-extrabold text-monokai-orange select-none leading-none drop-shadow-lg">
				404
			</p>

			<!-- Heading -->
			<h1 class="mt-6 text-2xl md:text-3xl font-bold text-monokai-pink">
				{heading}
			</h1>

			<!-- CTA -->
			<a
				href={buttonHref}
				class="mt-10 inline-flex items-center gap-2 rounded-xl border border-monokai-green/50 bg-monokai-green/15 px-6 py-3 font-semibold text-monokai-green hover:bg-monokai-green/25 transition-colors"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
				</svg>
				{buttonLabel}
			</a>
		</div>
	</main>
</Layout>
