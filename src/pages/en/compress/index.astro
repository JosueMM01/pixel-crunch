---
import { CompressorPanel } from '../../../components/features/compressor';
import ToolPage from '../../../components/pages/ToolPage.astro';
import translations from '../../../i18n/en.json';
import { siteContent } from '../../../i18n/site';
import Layout from '../../../layouts/Layout.astro';

const content = siteContent.en.compress;
---

<Layout title={content.title} description={content.description} lang="en" route="compress" pageName={content.heading} featureList={[...content.bullets]} faqItems={content.faq}>
  <ToolPage {...content} lang="en" route="compress" accent="cyan">
    <CompressorPanel
      client:load
      uploadCopy={translations.upload}
      qualityCopy={translations.compression.quality}
      compressionProgressCopy={translations.compression.progress}
      compressionStatsCopy={translations.compression.stats}
      previewCopy={translations.preview}
    />
  </ToolPage>
</Layout>
