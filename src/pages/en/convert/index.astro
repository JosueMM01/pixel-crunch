---
import { ConverterPanel } from '../../../components/features/converter';
import ToolPage from '../../../components/pages/ToolPage.astro';
import translations from '../../../i18n/en.json';
import { siteContent } from '../../../i18n/site';
import Layout from '../../../layouts/Layout.astro';

const content = siteContent.en.convert;
---

<Layout title={content.title} description={content.description} lang="en" route="convert" featureList={[...content.bullets]}>
  <ToolPage {...content} accent="pink">
    <ConverterPanel
      client:load
      uploadCopy={translations.converter.upload}
      previewCopy={translations.preview}
      converterCopy={translations.converter.panel}
    />
  </ToolPage>
</Layout>
