---
import { BackgroundRemoverPanel } from '../../components/features/background-remover';
import ToolPage from '../../components/pages/ToolPage.astro';
import translations from '../../i18n/es.json';
import { siteContent } from '../../i18n/site';
import Layout from '../../layouts/Layout.astro';

const content = siteContent.es.removeBackground;
---

<Layout title={content.title} description={content.description} lang="es" route="removeBackground" featureList={[...content.bullets]}>
  <ToolPage {...content} accent="green">
    <BackgroundRemoverPanel client:load copy={translations.backgroundRemoval} />
  </ToolPage>
</Layout>
