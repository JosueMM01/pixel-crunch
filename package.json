{
  "name": "pixel-crunch",
  "type": "module",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "author": "Josue Martinez Moreno (JosueMM01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosueMM01/pixel-crunch.git"
  },
  "homepage": "https://pixel-crunch.josuem01.dev/",
  "bugs": {
    "url": "https://github.com/JosueMM01/pixel-crunch/issues"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm assets:prepare && astro build",
    "assets:prepare": "node scripts/prepare-background-removal-assets.mjs",
    "check:build": "node scripts/check-build-budgets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "verify": "pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:build"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@imgly/background-removal": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.3",
    "browser-image-compression": "2.0.2",
    "clsx": "2.1.1",
    "file-saver": "2.0.5",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "jszip": "3.10.2",
    "lucide-react": "1.47.0",
    "onnxruntime-web": "1.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.2",
    "sonner": "2.0.8",
    "svgo": "4.1.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/file-saver": "2.0.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
